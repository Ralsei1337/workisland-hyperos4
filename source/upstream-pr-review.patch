+// ── 工作岛核心：事件 → 状态文案 → 完成判定 ────────────────────────────────
+// 纯逻辑，不碰进程、不读设置、不订阅总线；方便单元测试。
+// 外面的 work-island.mjs 负责把它接到真实总线、runs 和 am 上。
+//
+// 设计要点：
+//  · 更新最多 1.5 秒一次，只保留最后一条；到时补发最后那条。
+//  · 收工看 runs（所有活跃轮次），不看 run；run_end 后仍要等 3 秒宽限。
+//  · error 只显示「出错了」，不转发 message（可能含路径/命令输出）。
+//  · 文案跟随 LAST_LANG：zh 开头用中文，否则英文。
+
+const ZH_TOOLS = {
+  Bash: "执行命令", Read: "读文件", Write: "写文件", Edit: "改文件",
+  Glob: "找文件", Grep: "搜代码", WebSearch: "查资料", WebFetch: "读网页",
+  Task: "子任务", Agent: "子任务", TodoWrite: "整理清单", NotebookEdit: "改笔记",
+  Skill: "调用技能", KillShell: "收尾命令",
+};
+
+const EN_TOOL_NAMES = {
+  Bash: "a command", Read: "a file", Write: "a file", Edit: "a file",
+  Glob: "files", Grep: "code", WebSearch: "the web", WebFetch: "a page",
+  Task: "a subtask", Agent: "a subtask", TodoWrite: "the list",
+  NotebookEdit: "a notebook", Skill: "a skill", KillShell: "a command",
+};
+
+const EN_TOOL_TITLES = {
+  Bash: "Running", Read: "Reading", Write: "Writing", Edit: "Editing",
+  Glob: "Finding", Grep: "Searching", WebSearch: "Searching", WebFetch: "Reading",
+  Task: "Subtask", Agent: "Subtask", TodoWrite: "Updating list",
+  NotebookEdit: "Editing", Skill: "Skill", KillShell: "Stopping",
+};
+
+const ZH = {
+  working: "正在干活",
+  done: "任务完成",
+  waiting: "等你确认",
+  start: "正在处理…",
+  wait: "等模型回复…",
+  think: "正在想…",
+  text: "正在写回复…",
+  tool: (n) => `用 ${n}…`,
+  perm: (n) => `需要你确认：${n}`,
+  resume: "继续…",
+  compact: "整理上下文…",
+  sub: (d) => `子任务：${d}…`,
+  bg: "后台任务还在跑…",
+  error: "出错了",
+  aborted: "已中止",
+  idleTitle: "工作岛",
+  idleText: "在后台等下一轮",
+  took: (s) => `用时 ${s}`,
+  titleWait: "等模型",
+  titleThink: "思考中",
+  titleText: "写回复",
+  titleRetry: "重试中",
+  titleCompact: "整理上下文",
+  titleSub: "子任务",
+  titleBg: "后台任务",
+  titleError: "出错了",
+  todoTitle: "整理清单",
+  todo: (d, t) => `清单 ${d}/${t}`,
+  toolName: (n) => ZH_TOOLS[n] || n || "工具",
+  toolTitle: (n) => ZH_TOOLS[n] || n || "工具",
+};
+
+const EN = {
+  working: "Working",
+  done: "Done",
+  waiting: "Waiting for you",
+  start: "Processing…",
+  wait: "Waiting for the model…",
+  think: "Thinking…",
+  text: "Writing…",
+  tool: (n) => `Using ${n}…`,
+  perm: (n) => `Waiting for approval: ${n}`,
+  resume: "Continuing…",
+  compact: "Compacting context…",
+  sub: (d) => `Subtask: ${d}…`,
+  bg: "Background task still running…",
+  error: "Error",
+  aborted: "aborted",
+  idleTitle: "Work Island",
+  idleText: "Waiting for the next run",
+  took: (s) => `Took ${s}`,
+  titleWait: "Waiting",
+  titleThink: "Thinking",
+  titleText: "Writing",
+  titleRetry: "Retrying",
+  titleCompact: "Compacting",
+  titleSub: "Subtask",
+  titleBg: "Background",
+  titleError: "Error",
+  todoTitle: "Updating list",
+  todo: (d, t) => `List ${d}/${t}`,
+  toolName: (n) => EN_TOOL_NAMES[n] || n || "a tool",
+  toolTitle: (n) => EN_TOOL_TITLES[n] || n || "Tool",
+};
+
+function humanDuration(sec, zh) {
+  if (zh) return sec < 60 ? `${sec} 秒` : `${Math.floor(sec / 60)} 分 ${sec % 60} 秒`;
+  return sec < 60 ? `${sec}s` : `${Math.floor(sec / 60)}m ${sec % 60}s`;
+}
+
+/** TodoWrite 的清单进度：{ title, text }；不是清单工具返回 null */
+function todoProgress(ev, l) {
+  const todos = ev && ev.input && Array.isArray(ev.input.todos) ? ev.input.todos : null;
+  if (!todos) return null;
+  const total = todos.length;
+  const done = todos.filter((t) => t && t.status === "completed").length;
+  return { title: l.todoTitle, text: l.todo(done, total), state: "planning" };
+}
+
+const TOOL_STATE = {
+  Bash: "running", KillShell: "running",
+  Read: "reading", Glob: "reading", Grep: "reading",
+  Write: "writing", Edit: "writing", NotebookEdit: "writing",
+  WebSearch: "searching", WebFetch: "searching",
+  Task: "subtask", Agent: "subtask", Skill: "working",
+};
+const toolState = (name) => TOOL_STATE[name] || "working";
+
+/**
+ * @param {object} opts
+ * @param {(action:string,title:string,text:string,since:number)=>void} opts.send  发通知
+ * @param {()=>Array} [opts.runs]     读活跃轮次（默认空）
+ * @param {()=>string} [opts.lang]    最近界面语言
+ * @param {()=>number} [opts.clock]   当前时间（测试可替换）
+ * @param {number} [opts.graceMs]     收工宽限，默认 3000
+ * @param {number} [opts.idleMs]      完成后收起，默认 8000
+ * @param {number} [opts.throttleMs]  更新最小间隔，默认 1500
+ */
+export function createWorkIsland(opts = {}) {
+  const send = opts.send || (() => {});
+  const sendSync = opts.sendSync || send;
+  const runs = opts.runs || (() => []);
+  const lang = opts.lang || (() => "zh");
+  const clock = opts.clock || Date.now;
+  const graceMs = opts.graceMs ?? 3000;
+  const idleMs = opts.idleMs ?? 8000;
+  const throttleMs = opts.throttleMs ?? 1500;
+
+  const L = () => (String(lang() || "zh").startsWith("zh") ? ZH : EN);
+  const liveRuns = () => (runs() || []).filter((r) => r && !r.ended);
+
+  let active = null;        // { id, startedAt, last }
+  let doneTimer = null;
+  let idleTimer = null;
+  let lastSent = 0;
+  let pending = null;       // 节流时保留的最后一条
+  let pendingTimer = null;
+
+  const emit = (action, title, text, since, state) => {
+    try { send(action, title, text, since, state); } catch {}
+  };
+  const emitSync = (action, title, text, since, state) => {
+    try { sendSync(action, title, text, since, state); } catch {}
+  };
+
+  function clearPending() {
+    if (pendingTimer) { clearTimeout(pendingTimer); pendingTimer = null; }
+    pending = null;
+  }
+
+  function sendUpdate(title, text, since, state) {
+    const t = clock();
+    if (t - lastSent >= throttleMs) {
+      lastSent = t;
+      emit("UPDATE", title, text, since, state);
+      return;
+    }
+    pending = { title, text, since, state };
+    if (pendingTimer) return;
+    pendingTimer = setTimeout(() => {
+      pendingTimer = null;
+      if (!active || !pending) { pending = null; return; }
+      const p = pending;
+      pending = null;
+      lastSent = clock();
+      emit("UPDATE", p.title, p.text, p.since, p.state);
+    }, Math.max(0, throttleMs - (t - lastSent)));
+  }
+
+  function update(text, title, state) {
+    if (!active) return;
+    const t = title || L().working;
+    const x = text || "";
+    const st = state || "working";
+    const key = t + "|" + x + "|" + st;
+    if (key === active.last) return;
+    active.last = key;
+    sendUpdate(t, x, active.startedAt, st);
+  }
+
+  function start(run, text) {
+    if (active) {
+      if (run && run.id) active.id = run.id;
+      return update(text);
+    }
+    clearPending();
+    if (doneTimer) { clearTimeout(doneTimer); doneTimer = null; }
+    if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
+    active = {
+      id: (run && run.id) || "",
+      startedAt: Number(run && run.startedAt) || clock(),
+      last: "",
+    };
+    update(text || L().start, L().working, "working");
+  }
+
+  function finish(reason) {
+    if (!active) return;
+    const ms = Math.max(0, clock() - active.startedAt);
+    active = null;
+    clearPending();
+    if (doneTimer) clearTimeout(doneTimer);
+    doneTimer = setTimeout(() => {
+      doneTimer = null;
+      if (active) return;
+      const live = liveRuns();
+      if (live.length) { start(live[0]); return; }   // 宽限期内又跑起来了
+      const sec = Math.round(ms / 1000);
+      const human = humanDuration(sec, L() === ZH);
+      const text = L().took(human) + (reason ? ` · ${reason}` : "");
+      emit("DONE", L().done, text, 0, "done");
+      if (idleTimer) clearTimeout(idleTimer);
+      idleTimer = setTimeout(() => {
+        idleTimer = null;
+        if (!active) emit("IDLE", L().idleTitle, L().idleText, 0, "idle");
+      }, idleMs);
+    }, graceMs);
+  }
+
+  function handleEvent(ev) {
+    if (!ev || !ev.type) return;
+    switch (ev.type) {
+      case "run_start":
+        start(ev);
+        break;
+      case "state":
+        if (ev.run) start(ev.run);
+        else if (active && !liveRuns().length) finish("");
+        break;
+      case "run_busy":
+        update(L().resume, L().working, "working");
+        break;
+      case "phase":
+        if (ev.phase === "wait") update(L().wait, L().titleWait, "thinking");
+        else if (ev.phase === "think") update(L().think, L().titleThink, "thinking");
+        else if (ev.phase === "text") update(L().text, L().titleText, "writing");
+        else if (ev.phase === "tool") update(L().tool(L().toolName(ev.name)), L().toolTitle(ev.name), toolState(ev.name));
+        else if (ev.phase === "retry") update(L().wait, L().titleRetry, "thinking");
+        break;
+      case "tool_use": {
+        const todo = todoProgress(ev, L());
+        if (todo) update(todo.text, todo.title, todo.state);
+        else update(L().tool(L().toolName(ev.name)), L().toolTitle(ev.name), toolState(ev.name));
+        break;
+      }
+      case "perm_request":
+        update(L().perm(L().toolName(ev.tool || ev.name)), L().waiting, "waiting");
+        break;
+      case "perm_resolved":
+        update(L().resume, L().working, "working");
+        break;
+      case "compacting":
+        update(L().compact, L().titleCompact, "thinking");
+        break;
+      case "sub_progress":
+        update(L().sub(ev.desc || L().start), L().titleSub, "subtask");
+        break;
+      case "run_idle":
+        if (ev.bg > 0) update(L().bg, L().titleBg, "working");
+        break;
+      case "error":
+        update("", L().titleError, "error");   // 不转发 message：可能带路径/命令输出
+        break;
+      case "run_end":
+        if (!active) break;
+        if (liveRuns().length) break;   // 还有别的轮次在跑
+        finish(ev.aborted ? L().aborted : "");
+        break;
+    }
+  }
+
+  function stop(sync = false) {
+    const had = active;
+    active = null;
+    clearPending();
+    if (doneTimer) { clearTimeout(doneTimer); doneTimer = null; }
+    if (idleTimer) { clearTimeout(idleTimer); idleTimer = null; }
+    if (had) {
+      const fn = sync ? emitSync : emit;
+      fn("IDLE", L().idleTitle, L().idleText, 0, "idle");
+    }
+  }
+
+  return {
+    handleEvent,
+    start,
+    stop,
+    get active() { return active; },
+  };
+}
diff --git a/gateway/gw/work-island.mjs b/gateway/gw/work-island.mjs
new file mode 100644
index 0000000..0a7c9fb
--- /dev/null
+++ b/gateway/gw/work-island.mjs
@@ -0,0 +1,112 @@
+// ── 工作岛（可选集成）──────────────────────────────────────────────────────
+// 在网关进程里直接订阅事件总线，把 Claude 的工作状态经 am 送给「工作岛」应用。
+//
+// 约束：
+//  · 不另起进程：没有 detached child、没有 PID 文件、没有看门狗。
+//    网关停，订阅和定时器一起没，不会留孤儿。
+//  · 默认关闭：SETTINGS.workIsland 为 true 才检测应用、开始送状态。
+//  · 只用 Node 内置模块；应用没装就完全不启动。
+//  · 文案跟随 LAST_LANG；中文/英文两套。
+import fs from "node:fs";
+import { execFile, execFileSync } from "node:child_process";
+import { SETTINGS } from "./settings.mjs";
+import { runList } from "./runs.mjs";
+import { onPublish } from "./bus.mjs";
+import { LAST_LANG, log } from "./config.mjs";
+import { createWorkIsland } from "./work-island-core.mjs";
+
+const PKG = process.env.WORK_ISLAND_PKG || "com.dafeiyu.workisland";
+const SVC = PKG + "/.IslandService";
+
+function amArgs(action, title, text, since, state) {
+  const a = ["start-foreground-service", "--user", "0", "-n", SVC, "-a", PKG + "." + action];
+  if (title) a.push("--es", "title", title);
+  if (text) a.push("--es", "text", text);
+  if (state) a.push("--es", "state", state);
+  if (since) a.push("--el", "since", String(since));
+  return a;
+}
+
+let warned = false;
+function amSend(action, title, text, since, state) {
+  execFile("am", amArgs(action, title, text, since, state), { timeout: 8000 }, (e, out, err) => {
+    if (!e || warned) return;
+    warned = true;
+    log(`[work-island] am 失败（应用没装或服务未就绪？后面不再重复）：${e.message} ${String(err || "").slice(0, 120)}`);
+  });
+}
+function amSendSync(action, title, text, since, state) {
+  try {
+    execFileSync("am", amArgs(action, title, text, since, state), { timeout: 3000, stdio: "ignore" });
+  } catch {}
+}
+
+let started = false;
+let detecting = false;
+let unsub = null;
+let core = null;
+
+function isAndroid() {
+  return fs.existsSync("/system/bin/am");
+}
+
+function detectApp(cb) {
+  if (process.env.CCAPP_WORK_ISLAND === "1") return cb(true);
+  if (process.env.CCAPP_WORK_ISLAND === "0") return cb(false);
+  // pm 默认按“当前用户”查；应用 uid 会撞 INTERACT_ACROSS_USERS（asks to run as user 10），
+  // 必须显式 --user 0。包可见性由 AndroidManifest 的 <queries> 解决。
+  execFile("pm", ["list", "packages", "--user", "0", PKG], { timeout: 3000 }, (e, out) => {
+    cb(!e && String(out).includes("package:" + PKG));
+  });
+}
+
+export function startWorkIsland() {
+  if (started || detecting) return;
+  if (!SETTINGS.workIsland) return;              // 默认关，用户开了才动
+  if (process.env.CCAPP_WORK_ISLAND === "0") return;
+  if (!isAndroid()) return;
+  started = true;
+  detecting = true;
+  detectApp((ok) => {
+    detecting = false;
+    if (!started) return;                        // 检测期间被关掉了
+    if (!ok) {
+      started = false;
+      log("[work-island] 没检测到工作岛应用，跳过（装好后可在设置里重开一次）");
+      return;
+    }
+    core = createWorkIsland({
+      send: amSend,
+      sendSync: amSendSync,
+      runs: runList,
+      lang: () => LAST_LANG,
+    });
+    unsub = onPublish((ev) => {
+      try { core.handleEvent(ev); } catch {}
+    });
+    const live = runList().filter((r) => r && !r.ended);
+    if (live.length) core.start(live[0]);        // 开设置时已经有轮次在跑
+    log("[work-island] 已订阅网关事件");
+  });
+}
+
+export function stopWorkIsland(sync = false) {
+  started = false;
+  detecting = false;
+  if (unsub) { try { unsub(); } catch {} unsub = null; }
+  if (core) {
+    try { core.stop(sync); } catch {}
+    core = null;
+  }
+}
+
+/** 网关 SIGTERM：同步发一次 IDLE，让岛收起，再退出。 */
+export function stopWorkIslandSync() {
+  stopWorkIsland(true);
+}
+
+/** 设置页开关变化时调用。 */
+export function applyWorkIslandSetting() {
+  if (SETTINGS.workIsland) startWorkIsland();
+  else stopWorkIsland();
+}
